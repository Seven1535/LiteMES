<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.litemes</groupId>
        <artifactId>lite-mes</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>litemes-production</artifactId>
    <name>litemes-production</name>
    <description>业务数据服务（8082）：工单/派工/报工/看板 + WebSocket 实时推送，数据库 LITEMES_PRODUCTION（达梦）</description>

    <dependencies>
        <!-- 公共模块 -->
        <dependency>
            <groupId>com.litemes</groupId>
            <artifactId>litemes-common</artifactId>
        </dependency>
        <!-- Feign 契约模块 -->
        <dependency>
            <groupId>com.litemes</groupId>
            <artifactId>litemes-api</artifactId>
        </dependency>
        <!-- Nacos 注册中心 + 配置中心 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!-- Feign 调用方负载均衡 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- Boot 3 默认不读 bootstrap.yml -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
        <!-- WebSocket 实时推送（看板） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!-- 达梦 JDBC 驱动（方言在 Nacos/本地配置中指定） -->
        <dependency>
            <groupId>com.dameng</groupId>
            <artifactId>DmJdbcDriver18</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
